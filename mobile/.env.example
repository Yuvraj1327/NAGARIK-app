# Copy to mobile/.env before running the app. Never commit mobile/.env.
#
# Note: values bundled into a mobile app are extractable from the compiled
# build, so only ever put PUBLIC/anon keys here — never a service role key
# or any backend secret. The Supabase anon key is safe by design (it relies
# on Supabase Row Level Security, not secrecy, for protection).

# Supabase project (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# FastAPI backend base URL.
# Android emulator reaches the host machine's localhost via 10.0.2.2.
# iOS simulator can use localhost directly. A physical device needs your
# machine's LAN IP or a deployed URL.
API_BASE_URL=http://10.0.2.2:8000/api/v1
