# Copy to backend/.env and fill in real values. Never commit backend/.env.

# ---- App ----
APP_NAME="NAGARIK API"
ENVIRONMENT=local        # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Comma-separated list of origins allowed to call this API, e.g.:
# BACKEND_CORS_ORIGINS=http://localhost:3000,https://app.example.com
# For local Flutter dev this can stay empty; mobile apps don't send an
# Origin header, so CORS mainly matters for local web/testing tools.
BACKEND_CORS_ORIGINS=

# ---- Supabase ----
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_STORAGE_BUCKET=report-images
# How long (seconds) a signed image URL stays valid on report responses.
REPORT_IMAGE_SIGNED_URL_TTL_SECONDS=3600

# ---- Security ----
JWT_ALGORITHM=HS256
