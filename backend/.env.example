# Copy to backend/.env and fill in real values. Never commit backend/.env.

# ---- App ----
APP_NAME="NAGARIK API"
ENVIRONMENT=local        # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Comma-separated list of origins allowed to call this API, e.g.:
# BACKEND_CORS_ORIGINS=https://app.example.com
# The native Android/iOS app doesn't send an Origin header, so it's
# unaffected by this either way. This can stay empty for local dev: outside
# ENVIRONMENT=production, the API also auto-accepts any
# http(s)://localhost:<port> / 127.0.0.1:<port> origin (see
# `cors_local_dev_origin_regex` in app/core/config.py), which covers
# `flutter run -d chrome` on whatever port it happens to pick. Only add a
# real domain here when you have one (a deployed web build, an admin tool).
BACKEND_CORS_ORIGINS=

# ---- Supabase ----
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_STORAGE_BUCKET=report-images
# How long (seconds) a signed image URL stays valid on report responses.
REPORT_IMAGE_SIGNED_URL_TTL_SECONDS=3600
# Official Logo & User Profile Photo upgrade: a separate private bucket for
# profile photos (see migrations/0005_avatars_bucket.sql).
SUPABASE_AVATAR_BUCKET=avatars
# How long (seconds) a signed avatar URL stays valid.
AVATAR_SIGNED_URL_TTL_SECONDS=3600

# ---- Security ----
JWT_ALGORITHM=HS256
